# Lead Sources
V2_LEAD_SOURCE=real_estate
V2_LEAD_SOURCE_ORDER=real_estate,csv,api,mock
V2_LEAD_SOURCE_CSV_PATH=data/leads.csv
V2_LEAD_SOURCE_CSV_DIR=data/niche-leads
V2_LEAD_SOURCE_API_URL=https://api.example.com/leads
V2_LEAD_SOURCE_API_KEY=your_api_key_here
V2_LEAD_SOURCE_API_URL_TEMPLATE=https://api.example.com/leads?niche={niche}&location={location}&limit={limit}

# Default city and property type
V2_DEFAULT_CITY=delhi
V2_DEFAULT_PROPERTY_TYPE=residential_land

# AI / Language Model
OLLAMA_API_URL=http://127.0.0.1:11434/v1/outputs
OLLAMA_MODEL=llama2

# Communication
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_API_TOKEN=your_whatsapp_token_here

# Payment Processing
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Commission & Payment Terms
COMMISSION_CONVERSION_PLATFORM=10.0
COMMISSION_CONVERSION_SOURCE=3.0
COMMISSION_LEAD_SALE_PLATFORM=70.0
COMMISSION_LEAD_SALE_SOURCE=30.0
LATE_PAYMENT_GRACE_DAYS=15
LATE_PAYMENT_PENALTY_PERCENT_PER_WEEK=2.0
PAYMENT_SUSPENSION_AFTER_DAYS=60

# Mobile CRM API
MOBILE_CRM_API_KEY=changeme

# System Configuration
V2_LEAD_BATCH_SIZE=50
V2_OUTREACH_LIMIT=40
V2_FOLLOWUP_HOURS=24
MEMORY_DIR=memory
